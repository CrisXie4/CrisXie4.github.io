//- 作者自用好物（aff 推荐位）：数据 = source/_data/aff.yml 顶层列表 {name, link, icon?, descr}
- var $aff = site.data[page.data] || []
#aff
  if !$aff.length
    .aff-empty 六哥还在挑选值得推荐的好物，敬请期待
  else
    .aff-grid
      each it in $aff
        .aff-card
          .aff-head
            if it.icon
              img.aff-icon(src=it.icon, alt=it.name, loading='lazy', referrerpolicy='no-referrer', onerror='affIconFallback(this)')
            else
              .aff-icon.aff-icon-fb= (it.name || '荐').charAt(0)
            .aff-name= it.name
          if it.descr
            .aff-desc= it.descr
          if it.link
            a.aff-go(href=it.link, target='_blank', rel='nofollow sponsored noopener') 前往
  if page.disclosure
    .aff-disc= page.disclosure
script.
  /* 图标加载失败 → 用名字首字补位（和无图标样式一致） */
  window.affIconFallback = function (img) {
    var fb = document.createElement('div');
    fb.className = 'aff-icon aff-icon-fb';
    fb.textContent = (img.alt || '荐').charAt(0);
    img.replaceWith(fb);
  };
style.
  #aff{margin-top:26px}
  .aff-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px}
  .aff-card{display:flex;flex-direction:column;border-radius:12px;border:var(--style-border-always);background:var(--efu-card-bg);box-shadow:var(--efu-shadow-border);padding:18px;transition:.3s}
  .aff-card:hover{border-color:var(--efu-main);transform:translateY(-3px)}
  .aff-head{display:flex;align-items:center;gap:12px}
  .aff-icon{width:46px;height:46px;border-radius:12px;object-fit:cover;background:var(--efu-secondbg);flex:none}
  .aff-icon-fb{display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;color:var(--efu-white);background:var(--efu-main)}
  .aff-name{font-size:16px;font-weight:700;line-height:1.3;word-break:break-all}
  .aff-desc{margin-top:10px;font-size:14px;line-height:1.6;color:var(--efu-secondtext);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .aff-go{margin-top:14px;align-self:flex-start;font-size:13px;padding:5px 12px;border-radius:8px;background:var(--efu-gray-op);color:var(--efu-fontcolor);transition:.3s}
  .aff-card:hover .aff-go{background:var(--efu-main);color:var(--efu-white)}
  .aff-empty{padding:40px 0;text-align:center;color:var(--efu-secondtext)}
  .aff-disc{margin-top:18px;font-size:12px;color:var(--efu-secondtext);opacity:.8}
